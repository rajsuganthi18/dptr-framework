{
  "name": "dptr-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype defect-preserving self-healing GUI test repair framework for dynamic UI surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/dptr-framework"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "playwright test",
    "test:demo": "playwright test tests/demo.spec.ts --reporter=line",
    "experiment": "npm run build && node dist/src/experiments/experiment-runner.js",
    "analyze": "npm run build && node dist/src/experiments/analyze-results.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.57.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^6.0.0",
    "typescript": "^4.9.5"
  }
}
